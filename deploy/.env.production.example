# Ρυθμίσεις παραγωγής για structured-only deploy (semantic κλειστό).
# Η πρώτη γραμμή μένει ΠΑΝΤΑ σχόλιο, και το αρχείο αποθηκεύεται σε UTF-8
# χωρίς BOM: με BOM η πρώτη ρύθμιση του αρχείου αγνοείται σιωπηλά.
# Αντιγραφή σε backend/.env στον server (chmod 600, ιδιοκτήτης ο χρήστης της
# υπηρεσίας). Το app διαβάζει ΜΟΝΟ το backend/.env (ή μεταβλητές περιβάλλοντος
# της διεργασίας, που υπερισχύουν). Κάθε <CHANGEME_...> συμπληρώνεται από τον
# admin. Τα relative paths επιλύονται ως προς το cwd της διεργασίας, όχι ως
# προς το backend/, γι' αυτό τα paths εδώ είναι absolute.

# --- Δεδομένα ---------------------------------------------------------------
# Absolute path της SQLite βάσης (η DB που παραδόθηκε, βλ. README βήμα 5).
DB_PATH=<CHANGEME_DB_PATH>

# --- Semantic path (RAG): κλειστό ---------------------------------------------
# Με false δεν φορτώνονται torch, μοντέλα, chromadb, requests, και το
# /api/query/semantic απαντά 403. Είναι και το default του κώδικα.
SEMANTIC_ENABLED=false

# --- Logs χωρίς περιεχόμενο ---------------------------------------------------
# Το access log του uvicorn γράφει URLs, που περιέχουν person_id. Κλειστό.
ACCESS_LOG=false

# --- API docs ------------------------------------------------------------------
# /docs, /redoc, /openapi.json κλειστά στην παραγωγή.
ENABLE_DOCS=false

# --- Session cookie ----------------------------------------------------------
# Το cookie στέλνεται μόνο σε HTTPS. Μένει true: το portal σερβίρει HTTPS.
COOKIE_SECURE=true
# Path του cookie όπως το βλέπει ο browser. "/" αν η εφαρμογή είναι στη ρίζα
# του host, αλλιώς το prefix του portal (π.χ. /<CHANGEME_PREFIX>), ώστε το
# cookie να μη στέλνεται σε άλλες εφαρμογές του ίδιου host. Βλ. README,
# ενότητα "Portal / reverse proxy".
COOKIE_PATH=<CHANGEME_COOKIE_PATH>
# Απόλυτη διάρκεια session σε ώρες.
SESSION_HOURS=8

# --- Ollama ----------------------------------------------------------------------
# Με το semantic κλειστό το χρησιμοποιεί μόνο το /api/health (πεδίο
# ollama_reachable). Χωρίς Ollama στον server το health δίνει false και το UI
# δείχνει "Ollama μη διαθέσιμο": αναμενόμενο, δεν είναι σφάλμα.
OLLAMA_URL=http://127.0.0.1:11434
