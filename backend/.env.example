# Αντιγραφή σε backend/.env και προσαρμογή αν χρειάζεται. Όλες οι τιμές
# παρακάτω είναι οι defaults που ισχύουν ήδη στον κώδικα. Δεν χρειάζεται
# να δημιουργήσεις backend/.env αν σου βολεύουν οι defaults.

# Προσοχή: τα relative paths σε αυτό το αρχείο επιλύονται ως προς το cwd
# της διεργασίας, όχι ως προς το backend/. Αν χρειάζεται override, δώσε
# absolute paths (σε Windows με forward slashes).
#
# SQLite database path (idempotent persons/evaluations/scores/documents/audit_log)
# DB_PATH=backend/data/evalassist.db
#
# Φάκελος των PDF για το άνοιγμα εγγράφου (GET .../documents/{doc_id}/file).
# Κενό: το endpoint απαντά πάντα 404. Στη μηχανή ανάπτυξης τα paths της ΒΔ
# είναι σχετικά με το root του repo.
# DOCS_ROOT=/absolute/path/to/repo
# MAX_DOC_BYTES=52428800
#
# ChromaDB persistence directory (semantic chunks)
# CHROMA_PATH=backend/chroma_db
CHROMA_COLLECTION=evaluation_chunks

# Τοπικά ML models (HuggingFace Hub, one-off download, offline μετά)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Τοπικό Ollama endpoint + μοντέλο
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# OLLAMA_GEN_MODEL=
# Separate model for semantic RAG answer generation only.
# Leave empty to use OLLAMA_MODEL. For fluent Greek, recommend a Greek-native model.

# Deterministic generation (semantic RAG reproducibility)
# temperature=0.0 + seed=42 δίνει επαναλήψιμα outputs για ίδιο prompt+model.
# Απαραίτητο για prompt evaluation και regression testing.
# OLLAMA_TEMPERATURE=0.0
# OLLAMA_SEED=42

# Semantic RAG retrieval/rerank depth
TOP_K_RETRIEVE=20
TOP_K_RERANK=5

# Session cookie (login). Frontend και API είναι same-origin, άρα κανένα CORS.
# COOKIE_SECURE: το cookie στέλνεται μόνο σε HTTPS. Μένει true και στο dev:
# Chrome/Firefox δέχονται Secure cookie στο http://localhost (Safari όχι).
# COOKIE_SECURE=true
# Απόλυτη λήξη session σε ώρες (χωρίς ανανέωση με τη χρήση).
# SESSION_HOURS=8
# Path του cookie. Στην παραγωγή πίσω από το portal ορίζεται σε
# "/evalassist/", ώστε ο browser να μη στέλνει το session cookie στις άλλες
# εφαρμογές του ίδιου host. Τοπικά μένει το default "/".
# COOKIE_PATH=/
# /docs, /redoc, /openapi.json: κλειστά by default. true μόνο για τοπικό dev.
# ENABLE_DOCS=false

# Σημασιολογική αναζήτηση (RAG). Κλειστή by default: με false το
# /api/query/semantic απαντά 403 χωρίς retrieval/LLM και χωρίς να φορτωθούν
# τα μοντέλα, και το frontend απενεργοποιεί την επιλογή. Στις μηχανές
# ανάπτυξης μπαίνει SEMANTIC_ENABLED=true με το χέρι στο backend/.env.
SEMANTIC_ENABLED=false

# Access log του uvicorn (γραμμή ανά αίτημα). Κλειστό by default: τα URLs
# περιέχουν person_id και τα logs των jobs στο ailab26 τα διαβάζουν όλοι.
# Ανεξάρτητα από αυτό, καμία εξαίρεση δεν γράφει μήνυμα ή traceback στο log.
# ACCESS_LOG=false

# Ollama HTTP read timeout σε δευτερόλεπτα. Σε CPU-only μηχανές (π.χ. Windows
# χωρίς CUDA) το generation μπορεί να ξεπεράσει το default. Προτεινόμενο: 600.
# OLLAMA_TIMEOUT_S=120
