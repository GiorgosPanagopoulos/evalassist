# Αντιγραφή σε backend/.env και προσαρμογή αν χρειάζεται. Όλες οι τιμές
# παρακάτω είναι οι defaults που ισχύουν ήδη στον κώδικα. Δεν χρειάζεται
# να δημιουργήσεις backend/.env αν σου βολεύουν οι defaults.

# Προσοχή: τα relative paths σε αυτό το αρχείο επιλύονται ως προς το cwd
# της διεργασίας, όχι ως προς το backend/. Αν χρειάζεται override, δώσε
# absolute paths (σε Windows με forward slashes).
#
# SQLite database path (idempotent persons/evaluations/scores/documents/audit_log)
# DB_PATH=backend/data/evalassist.db
#
# ChromaDB persistence directory (semantic chunks)
# CHROMA_PATH=backend/chroma_db
CHROMA_COLLECTION=evaluation_chunks

# Τοπικά ML models (HuggingFace Hub, one-off download, offline μετά)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Τοπικό Ollama endpoint + μοντέλο
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# OLLAMA_GEN_MODEL=
# Separate model for semantic RAG answer generation only.
# Leave empty to use OLLAMA_MODEL. For fluent Greek, recommend a Greek-native model.

# Semantic RAG retrieval/rerank depth
TOP_K_RETRIEVE=20
TOP_K_RERANK=5

# CORS origins επιτρεπτά στο API (Φάση 4), JSON list
ALLOWED_ORIGINS=["http://localhost:5173"]

# Ollama HTTP read timeout σε δευτερόλεπτα. Σε CPU-only μηχανές (π.χ. Windows
# χωρίς CUDA) το generation μπορεί να ξεπεράσει το default. Προτεινόμενο: 600.
# OLLAMA_TIMEOUT_S=120
